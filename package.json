{
  "name": "japanese-readability-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "LLM が出力する日本語の読みやすさを、モデル間比較と改善施策（ルール・lint・プロンプト）の両面から評価するベンチマーク",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "bench": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:text": "textlint",
    "demo": "tsx src/cli.ts run --run demo --models mock-plain,mock-verbose --interventions baseline,textlint-fix && tsx src/cli.ts score --run demo && tsx src/cli.ts report --run demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "commander": "^15.0.0",
    "kuromojin": "^3.0.0",
    "openai": "^7.9.0",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-japanese": "^10.0.4",
    "yaml": "^2.8.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
